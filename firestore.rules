rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function myOrgId() {
      return myProfile().orgId;
    }
    // Head, or a solo teacher working in their own personal space, can edit.
    // Org teachers (mode == 'org' and role == 'teacher') are read-only.
    function canEdit() {
      return myProfile().role == 'head' || myProfile().mode == 'solo';
    }
    // Attendance is the one exception where org teachers can write too.
    function canMarkAttendance() {
      return canEdit() || (myProfile().role == 'teacher' && myProfile().mode == 'org');
    }
    function inMyOrg(data) {
      return data.orgId == myOrgId();
    }
    function isParent() {
      return myProfile().role == 'parent';
    }
    // Staff (head/teacher) see every record in their org; a parent only
    // ever sees records belonging to their own linked child, never anyone
    // else's — this is the core privacy boundary for the parent portal.
    function isLinkedStudent(studentId) {
      return isParent() && studentId in myProfile().linkedStudentIds;
    }
    function canSeeStudentData(data) {
      return (inMyOrg(data) && !isParent()) || isLinkedStudent(data.studentId);
    }

    // Each user's own profile doc — anyone signed in can read profiles
    // (needed so a head can list their teachers), but you can only write your own.
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Organizations — anyone signed in can read (needed to validate join
    // codes before they have a profile yet); only the head can update/delete.
    match /organizations/{orgId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && resource.data.headUid == request.auth.uid;
    }

    // Parent access codes — a minimal, separate lookup so a brand-new
    // parent (no profile yet) can find which student a code belongs to,
    // without needing broad read access to actual student records. The
    // code itself (unguessable, shared out-of-band) is the credential.
    match /parentCodes/{code} {
      allow read: if signedIn();
      allow write: if signedIn() && inMyOrg(request.resource.data) && canEdit();
    }

    match /students/{docId} {
      allow read: if signedIn() && (
        (inMyOrg(resource.data) && !isParent()) ||
        (isParent() && docId in myProfile().linkedStudentIds)
      );
      allow create: if signedIn() && inMyOrg(request.resource.data) && canEdit();
      allow update, delete: if signedIn() && inMyOrg(resource.data) && canEdit();
    }

    match /attendance/{docId} {
      allow read: if signedIn() && canSeeStudentData(resource.data);
      allow write: if signedIn() && inMyOrg(request.resource.data) && canMarkAttendance();
    }

    match /feePayments/{docId} {
      allow read: if signedIn() && canSeeStudentData(resource.data);
      allow write: if signedIn() && inMyOrg(request.resource.data) && canEdit();
    }

    // Exam metadata (name/date/batch/total marks — no individual scores)
    // is low-sensitivity, so org-wide read including parents is fine.
    match /exams/{docId} {
      allow read: if signedIn() && inMyOrg(resource.data);
      allow create: if signedIn() && inMyOrg(request.resource.data) && canEdit();
      allow update, delete: if signedIn() && inMyOrg(resource.data) && canEdit();
    }

    // Individual marks are sensitive — same student-scoped rule as
    // attendance/fees.
    match /examMarks/{docId} {
      allow read: if signedIn() && canSeeStudentData(resource.data);
      allow write: if signedIn() && inMyOrg(request.resource.data) && canEdit();
    }

    // Teacher salary/assignment records — head only, never parents.
    match /teachers/{docId} {
      allow read: if signedIn() && inMyOrg(resource.data) && !isParent();
      allow write: if signedIn() && inMyOrg(request.resource.data) && myProfile().role == 'head';
    }

    match /salaryPayments/{docId} {
      allow read: if signedIn() && inMyOrg(resource.data) && !isParent();
      allow write: if signedIn() && inMyOrg(request.resource.data) && myProfile().role == 'head';
    }

    // Suggestions — internal staff channel, never visible to parents.
    match /suggestions/{docId} {
      allow read: if signedIn() && inMyOrg(resource.data) && !isParent();
      allow create: if signedIn() && inMyOrg(request.resource.data) && !isParent();
      allow update: if signedIn() && inMyOrg(resource.data) && myProfile().role == 'head';
    }

    // Notices/homework board — low-sensitivity announcements, fine for
    // parents to read too; only head/solo can post.
    match /notices/{docId} {
      allow read: if signedIn() && inMyOrg(resource.data);
      allow create: if signedIn() && inMyOrg(request.resource.data) && canEdit();
      allow update, delete: if signedIn() && inMyOrg(resource.data) && canEdit();
    }

    match /homework/{docId} {
      allow read: if signedIn() && inMyOrg(resource.data);
      allow create: if signedIn() && inMyOrg(request.resource.data) && canEdit();
      allow update, delete: if signedIn() && inMyOrg(resource.data) && canEdit();
    }

    // Expenses/income ledger — financial data, restricted to whoever fully
    // owns the org's money. canEdit() already excludes parents and org
    // teachers, so this alone is sufficient.
    match /transactions/{docId} {
      allow read: if signedIn() && inMyOrg(resource.data) && canEdit();
      allow create: if signedIn() && inMyOrg(request.resource.data) && canEdit();
      allow update, delete: if signedIn() && inMyOrg(resource.data) && canEdit();
    }

    // Notifications — anyone in the org can create one aimed at a teammate
    // (e.g. a teacher notifying the head), but you can only read/update
    // (mark read) notifications addressed to you.
    match /notifications/{docId} {
      allow read, update: if signedIn() && resource.data.targetUid == request.auth.uid;
      allow create: if signedIn() && inMyOrg(request.resource.data);
    }

    // Parent <-> Head messages. Either side of a thread can read/write
    // within their own conversation; nobody else can see it.
    match /messages/{docId} {
      allow read, update: if signedIn() && (
        resource.data.parentUid == request.auth.uid ||
        resource.data.headUid == request.auth.uid
      );
      allow create: if signedIn() && (
        (isParent() && request.resource.data.parentUid == request.auth.uid) ||
        (myProfile().role == 'head' && request.resource.data.headUid == request.auth.uid)
      );
    }
  }
}
